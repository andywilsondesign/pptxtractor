#!/bin/bash
# pptxtractor - bulk-extract faithful representations from PowerPoint decks.
# https://github.com/andywilsondesign/pptxtractor
set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SRC="$HERE/../src"

usage() {
cat <<'USAGE'
pptxtractor - bulk-extract faithful representations from PowerPoint decks.

  pptxtractor audit  <folder> [--json FILE]
      Read every .pptx under <folder> without opening PowerPoint. Reports slide
      counts, aspect ratios, fonts that will be substituted, animation builds,
      embedded media, speaker notes and duplicates. Emits JSON.

  pptxtractor fonts <folder> [--install] [--json FILE]
      Say what to do about the faces those decks want and this Mac does not
      have. Sorts them into the ones already here under another name, the ones
      that are not fonts at all, and the ones needing a free stand-in - chosen
      by measured width, because a substitute wider than the face it replaces
      overflows the text box. --install builds and installs them, reversibly.
      Reporting needs nothing extra; --install needs fontTools.

  pptxtractor export <folder|deck.pptx> [--out <folder>] [options]
      Export each deck to a vector PDF via PowerPoint, with speaker notes
      attached and playable media extracted alongside. Give it a whole tree or
      a single .pptx. Each deck becomes one "<name> (export)" folder holding
      its PDF, media and images.

      --out DIR         where the archive goes. Without it, exports land in
                        ~/Documents/pptxtractor/<today>/
      --layout HOW      mirror (default) recreates the source folders under
                        --out; beside writes next to each deck instead;
                        flat puts every export in one folder
      --on-conflict WHAT   what to do when a deck was already exported:
                        ask (default in a terminal), skip (default otherwise),
                        overwrite, or new to keep both
      --states          expand animation builds into extra PDF pages
      --format FMT      also render images: png (default), jpeg, jpg
      --edge N          image long edge in px (3840 = 4K)
      --only TEXT       substring filter on the deck path
      --no-notes        do not attach speaker notes
      --no-media        do not extract media
      --svg             also extract embedded SVGs
      --deadline N      seconds per deck before giving up (default 240)
      --no-caffeinate   do not hold the Mac awake for the run
      --dry-run         list what would be exported and stop

  pptxtractor render <archive> [--format FMT] [--edge N] [--only TEXT]
                                [--page N] [--force]
      Render images from PDFs the export already produced. PowerPoint is not
      involved, so this is fast and repeatable at any size.

  pptxtractor plough
      Watch the tractor go. Does nothing else - it is there so you can see
      what a run looks like without committing a library to it.

  pptxtractor version | help

Requires macOS. `export` drives Microsoft PowerPoint (2016 or newer) and
cannot run without it; `audit` and `render` need neither.

Exit status: 0 all good, 1 one or more decks failed, 2 bad arguments,
3 PowerPoint missing or too old, 4 not allowed to control PowerPoint.
USAGE
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  audit)   exec python3 "$SRC/audit.py" "$@" ;;
  fonts)   exec python3 "$SRC/fonts.py" "$@" ;;
  export)  exec bash "$SRC/export.sh" "$@" ;;
  render)  exec bash "$SRC/render.sh" "$@" ;;
  version) echo "pptxtractor 1.0.1" ;;
  plough|demo) . "$SRC/farm.sh"; farm_demo ;;
  help|-h|--help) usage ;;
  *) echo "unknown command: $cmd"; echo; usage; exit 2 ;;
esac
